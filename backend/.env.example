# Backend configuration template.
#
# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env`.

# Port the API listens on (hosts usually inject this themselves).
PORT=5000

# MongoDB connection string (Atlas or self-hosted).
MONGO_URI=

# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# production also switches the session cookie to Secure.
NODE_ENV=development

# Comma separated list of frontends allowed to call this API with credentials.
# Local dev:
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
# Deployed (frontend on GitHub Pages, API on its own host):
# CLIENT_ORIGIN=https://zyphorian.github.io

# Session cookie attributes. Cross-site deployments (frontend and API on
# different sites) REQUIRE: COOKIE_SAMESITE=none with HTTPS, otherwise the browser
# drops the cookie and login never persists. Locally keep lax over plain http.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
